{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["vite/client"],
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        // src/lib/tabler.ts imports single components from Tabler's TS sources (smaller bundle); type them with the
        // published declarations so tsc doesn't check those sources against our strict settings.
        "paths": {
            "@tabler/core/js/src/*": ["./node_modules/@tabler/core/dist/types/src/*"]
        }
    },
    "include": ["src"]
}
